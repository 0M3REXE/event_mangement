<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Login</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;margin:0;display:flex;align-items:center;justify-content:center;height:100vh;}
.card{background:#fff;padding:30px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1);width:320px;}
h2{text-align:center;margin-bottom:20px;}
input{width:100%;padding:10px;margin:8px 0;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;}
button{width:100%;padding:10px;background:#2563eb;color:#fff;border:none;border-radius:4px;cursor:pointer;}
.err{color:#dc2626;text-align:center;margin-bottom:10px;}
.hint{font-size:12px;color:#666;text-align:center;margin-top:10px;}
a{display:block;text-align:center;margin-top:10px;color:#2563eb;}
</style></head>
<body>
<div class="card">
<h2>Login</h2>
<% if (error) { %><div class="err"><%= error %></div><% } %>
<form method="POST" action="/login">
  <input name="username" placeholder="Username" required>
  <input name="password" type="password" placeholder="Password" required>
  <button type="submit">Login</button>
</form>
<a href="/register">Create student account</a>
<div class="hint">Admin: admin / admin123</div>
</div>
</body></html>
