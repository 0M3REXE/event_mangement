<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Confirmation</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;margin:0;display:flex;align-items:center;justify-content:center;height:100vh;}
.card{background:#fff;padding:30px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.1);width:420px;text-align:center;}
h2{margin-bottom:10px;}
a{display:inline-block;margin-top:15px;padding:8px 16px;background:#2563eb;color:#fff;text-decoration:none;border-radius:4px;}
</style></head>
<body>
<div class="card">
<% if (status==='success') { %>
  <h2>Registration Confirmed</h2>
  <p>You are registered for <b><%= event.title %></b>.</p>
<% } else if (status==='already') { %>
  <h2>Already Registered</h2>
  <p>You already registered for <b><%= event.title %></b>.</p>
<% } else { %>
  <h2>Event Full</h2>
  <p><b><%= event.title %></b> has reached capacity.</p>
<% } %>
<a href="/events">Back to Events</a>
</div>
</body></html>
