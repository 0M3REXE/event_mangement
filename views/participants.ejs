<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Participants</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;margin:0;}
.nav{background:#2563eb;color:#fff;padding:12px 20px;}
.nav a{color:#fff;text-decoration:none;margin-left:15px;}
.container{max-width:900px;margin:20px auto;padding:0 20px;}
table{width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.1);}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid #eee;}
th{background:#f1f5f9;}
</style></head>
<body>
<div class="nav"><span>Participants - <%= event.title %></span><a href="/admin">Back</a></div>
<div class="container">
<table>
<tr><th>Name</th><th>Username</th><th>Email</th><th>Registered At</th></tr>
<% parts.forEach(p=>{ %>
<tr><td><%= p.name %></td><td><%= p.username %></td><td><%= p.email %></td><td><%= p.registered_at %></td></tr>
<% }) %>
</table>
<% if (parts.length===0) { %><p>No participants yet.</p><% } %>
</div>
</body></html>
