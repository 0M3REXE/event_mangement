<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>New Event</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;margin:0;}
.nav{background:#2563eb;color:#fff;padding:12px 20px;}
.nav a{color:#fff;text-decoration:none;margin-left:15px;}
.container{max-width:600px;margin:20px auto;padding:0 20px;}
.card{background:#fff;padding:20px;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);}
input,textarea{width:100%;padding:10px;margin:8px 0;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;}
button{padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:4px;cursor:pointer;}
</style></head>
<body>
<div class="nav"><span>Create Event</span><a href="/admin">Back</a></div>
<div class="container"><div class="card">
<form method="POST" action="/admin/events">
  <input name="title" placeholder="Event Title" required>
  <textarea name="description" placeholder="Description" rows="3"></textarea>
  <input name="event_date" type="date" required>
  <input name="venue" placeholder="Venue" required>
  <input name="capacity" type="number" placeholder="Capacity" value="50">
  <button type="submit">Create Event</button>
</form>
</div></div>
</body></html>
